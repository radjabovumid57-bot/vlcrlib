/*
 * vlcrlib_config.h — generated by CMake. Do not edit.
 *
 * Records which optional backends this build was configured with, so
 * application code can gate on a feature without knowing the CMake cache
 * variables or the vcpkg install state:
 *
 *     #if VLCRLIB_HAS_FASTGLTF
 *         Model m = vfastgltf_lib_build_model(vfastgltf_lib_load(p, 0, &info), NULL);
 *     #else
 *         Model m = FastLoadGltf(p);
 *     #endif
 *
 * A macro is 1 only when the corresponding library was actually found and
 * the wrapper compiled; it is never 1 in a build where the symbols are
 * absent, so testing it is always safe.
 */

#ifndef VLCRLIB_CONFIG_H
#define VLCRLIB_CONFIG_H

/* spnda/fastgltf wrapper (src/vfastgltf_lib.cpp). 1 = fastgltf found. */
#define VLCRLIB_HAS_FASTGLTF @VLCRLIB_CFG_HAS_FASTGLTF@

/* Jolt Physics backend (src/vjolt.cpp). 1 = Jolt found. */
#define VLCRLIB_HAS_JOLT @VLCRLIB_CFG_HAS_JOLT@

/* VLC audio backend (src/vaudio.c). 1 = VLC SDK enabled. */
#define VLCRLIB_HAS_VLC @VLCRLIB_CFG_HAS_VLC@

/* Graphics backend chosen by the build. */
#define VLCRLIB_CFG_USE_VULKAN @VLCRLIB_USE_VULKAN_VALUE@
#define VLCRLIB_CFG_USE_WEBGPU @VLCRLIB_CFG_USE_WEBGPU@

/* Platform name as selected by CMake, e.g. "windows". */
#define VLCRLIB_CFG_PLATFORM "@VLCRLIB_PLATFORM@"

#endif /* VLCRLIB_CONFIG_H */
