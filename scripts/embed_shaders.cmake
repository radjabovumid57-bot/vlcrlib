# embed_shaders.cmake — generate a C lookup table of SPIR-V blobs.
#
# Android APKs only carry jniLibs and assets, so the shaders/ directory that
# the build copies next to the static library never reaches the device.
# This script packs every compiled .spv into a generated C file that
# createShaderModule() can fall back to.
#
# Invoked as: cmake -DSPV_DIR=<dir> -DOUT=<file.c> -P embed_shaders.cmake

if(NOT DEFINED SPV_DIR OR NOT DEFINED OUT)
    message(FATAL_ERROR "embed_shaders.cmake: SPV_DIR and OUT are required")
endif()

file(GLOB spv_files "${SPV_DIR}/*.spv")
list(SORT spv_files)
if(NOT spv_files)
    message(FATAL_ERROR "embed_shaders.cmake: no .spv files in ${SPV_DIR}")
endif()

set(_arrays "")
set(_table "")
foreach(_spv ${spv_files})
    get_filename_component(_name "${_spv}" NAME)
    string(MAKE_C_IDENTIFIER "spv_${_name}" _sym)

    file(READ "${_spv}" _hex HEX)
    # "07230203..." -> "0x07,0x23,0x02,0x03,..."
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    # Pack byte quads into little-endian words, one word per line. SPIR-V is
    # always a multiple of 4 bytes, so no tail handling is needed.
    string(REGEX REPLACE
        "(0x[0-9a-f][0-9a-f]),(0x[0-9a-f][0-9a-f]),(0x[0-9a-f][0-9a-f]),(0x[0-9a-f][0-9a-f]),"
        "VSPV_WORD(\\1,\\2,\\3,\\4),\n"
        _words "${_bytes}")

    string(APPEND _arrays
        "static const uint32_t ${_sym}[] = {\n${_words}};\n\n")
    string(APPEND _table
        "    { \"shaders/${_name}\", ${_sym}, (unsigned int)sizeof(${_sym}) },\n")
    message(STATUS "embed_shaders: ${_name}")
endforeach()

file(WRITE "${OUT}" "/* Generated by scripts/embed_shaders.cmake — do not edit. */
#include <stdint.h>
#include <string.h>

#define VSPV_WORD(a, b, c, d) \\
    ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) | \\
     ((uint32_t)(d) << 24))

${_arrays}typedef struct VlcrEmbeddedShader {
    const char *path;
    const uint32_t *words;
    unsigned int bytes;
} VlcrEmbeddedShader;

static const VlcrEmbeddedShader kEmbeddedShaders[] = {
${_table}};

const unsigned char *vlcrlib_EmbeddedShaderLookup(const char *path,
                                                  unsigned int *size) {
    if (!path || !path[0] || !size) return NULL;
    for (size_t i = 0; i < sizeof(kEmbeddedShaders) / sizeof(kEmbeddedShaders[0]);
         ++i) {
        if (strcmp(kEmbeddedShaders[i].path, path) == 0) {
            *size = kEmbeddedShaders[i].bytes;
            return (const unsigned char *)kEmbeddedShaders[i].words;
        }
    }
    return NULL;
}
")
message(STATUS "embed_shaders: wrote ${OUT}")
